# ─────────────────────────────────────────────
# Supabase (dejalo vacio para trabajar en MODO DEMO)
# ─────────────────────────────────────────────
# Project URL y anon key: Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────
# Contacto y pagos (editables tambien desde /admin/epk)
# ─────────────────────────────────────────────
# Numero con codigo de pais, sin +, espacios ni guiones. Ej: 5493442000000
VITE_WHATSAPP_NUMBER=5493442000000
VITE_CONTACT_EMAIL=contacto@sumapaciencia.com.ar
VITE_ALIAS_TRANSFERENCIA=SUMA.PACIENCIA.MP

# ─────────────────────────────────────────────
# Mercado Pago (opcional)
# ─────────────────────────────────────────────
# VITE_MP_ENABLED=true activa el botón de Mercado Pago en el checkout.
# La preferencia se firma en el servidor (api/create-preference.ts).
# MERCADOPAGO_ACCESS_TOKEN se define como variable de entorno del servidor en Vercel.
VITE_MP_ENABLED=false
VITE_MP_PREFERENCE_ENDPOINT=/api/create-preference

# ─────────────────────────────────────────────
# Acceso al panel /admin en modo demo
# ─────────────────────────────────────────────
VITE_DEMO_ADMIN_EMAIL=admin@sumapaciencia.com
VITE_DEMO_ADMIN_PASSWORD=suma2026
